# Copy this file to backend/.env for local use. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./instance/chitragupta.db
DEFAULT_CURRENCY=INR
HIGH_OVERDUE_THRESHOLD_PAISE=5000000
CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

# Gemini Finance Copilot (add your real key in backend/.env — never commit it)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT_SECONDS=30
